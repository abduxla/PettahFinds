rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Two valid admin signals, either grants admin:
    //   1) Custom claim `admin: true` set via Admin SDK / a trusted
    //      backend: admin.auth().setCustomUserClaims(uid, { admin: true }).
    //      Preferred — no extra Firestore read per rule eval.
    //   2) Firestore /users/{uid} doc with role == 'admin'. Pragmatic
    //      fallback so admins can be promoted via the Firebase console
    //      without standing up a backend just to flip claims. Costs one
    //      extra get() per admin-gated request — acceptable while the
    //      admin set is small.
    // Either bootstraps the in-app admin shell + grants the privileged
    // writes below.
    function isAdmin() {
      // `'admin' in token` guard: reading a missing custom claim can raise
      // an evaluation error; Firestore's engine happens to recover inside
      // `||`, but the Storage engine does not — keep both rulesets on the
      // same defensive pattern so they never drift apart.
      return isSignedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true)
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // True if the given businessId doc exists and is owned by the caller.
    function ownsBusiness(businessId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/businesses/$(businessId))
        && get(/databases/$(database)/documents/businesses/$(businessId))
             .data.ownerUid == request.auth.uid;
    }

    // Fields a user is allowed to change on their own profile.
    // fcmToken + fcmUpdatedAt are added so the device can persist
    // its push token via NotificationService without privileged
    // write access. Both fields are also writable on their own
    // (token-refresh path — see the second update branch below).
    function userSelfMutableFields() {
      return ['displayName', 'phoneNumber', 'photoUrl',
              'onboardingCompleted', 'businessId',
              'fcmToken', 'fcmUpdatedAt',
              'mustChangePassword'];
    }

    // Fields a business owner is allowed to edit on their own business doc
    // (excludes isVerified, membershipTier, ratingAvg, ratingCount, ownerUid).
    function businessOwnerMutableFields() {
      return ['businessName', 'ownerName', 'ownerPhone',
              'location', 'description', 'phone', 'email',
              'whatsappNumber', 'category', 'logoUrl', 'bannerUrl',
              'latitude', 'longitude'];
    }

    // ---------- Users ----------
    match /users/{uid} {
      // Users can read only their own profile. Admins can read any.
      allow read: if isOwner(uid) || isAdmin();

      // Create: only the authenticated user, and role must be 'user' or
      // 'business' (never 'admin' — that is set via custom claims only).
      allow create: if isOwner(uid)
                    && request.resource.data.role in ['user', 'business'];

      // Update: owner may only change non-privileged fields. role and any
      // other privileged field stay frozen for the client; admins can change
      // anything. businessId change is allowed only to a business the caller
      // actually owns.
      allow update: if isAdmin()
                    || (
                      isOwner(uid)
                      && request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasOnly(userSelfMutableFields())
                      && (
                        request.resource.data.businessId == resource.data.businessId
                        || request.resource.data.businessId == null
                        || request.resource.data.businessId == ''
                        || ownsBusiness(request.resource.data.businessId)
                      )
                      // mustChangePassword: the owner may only CLEAR the
                      // flag (after completing the forced password change).
                      // Setting it is reserved for provisionPortalAccess
                      // (Admin SDK) and admins.
                      && (
                        !request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasAny(['mustChangePassword'])
                        || request.resource.data.mustChangePassword == false
                      )
                    );

      // Self-delete (GDPR right-to-be-forgotten) and admin delete.
      // Owner-side deletion is the last step of the cascade in
      // AccountDeletionService.deleteSelf.
      allow delete: if isAdmin() || isOwner(uid);
    }

    // ---------- Businesses ----------
    match /businesses/{businessId} {
      // Three read paths:
      //   1. Verified listings — public (the customer directory).
      //   2. Admin — sees everything, including the review queue.
      //   3. Owner — sees their own listing even while unverified, so
      //      the merchant dashboard renders during the review wait.
      //
      // Note for list queries: Firestore evaluates this rule per-doc on
      // every result. A list query MUST narrow to docs the rule allows,
      // otherwise the query fails permission-denied. Customer screens
      // therefore use repository methods that filter on
      // `isVerified == true`; admin screens use the explicit admin
      // methods (`streamAllIncludingPending`, `streamPending`) which
      // pass via the isAdmin() branch.
      allow read: if resource.data.isVerified == true
                  || isAdmin()
                  || (
                    isSignedIn()
                    && resource.data.ownerUid == request.auth.uid
                  );

      // Create paths:
      //   1. Admin — may create a business for anyone. Used by the
      //      manual onboarding flow in the admin shell; ownerUid is
      //      typically the merchant's UID (looked up by email), and
      //      `createdByAdminUid` is stamped for audit. Verification
      //      may be pre-toggled here too.
      //   2. Self-signup — caller must stamp themselves as ownerUid, cannot
      //      pre-verify themselves, and cannot seed a fake initial rating.
      //      Rating fields must be absent or zero (the model writes 0.0/0);
      //      all real rating changes flow through the onReviewWritten trigger.
      allow create: if isAdmin()
                    || (
                      isSignedIn()
                      && request.resource.data.ownerUid == request.auth.uid
                      && request.resource.data.isVerified == false
                      && (!('ratingAvg' in request.resource.data.keys())
                          || request.resource.data.ratingAvg == 0)
                      && (!('ratingCount' in request.resource.data.keys())
                          || request.resource.data.ratingCount == 0)
                      // Founding-50 badge is minted ONLY by the
                      // onBusinessCreated transaction — a signup can't
                      // award itself the honor.
                      && !('foundingMember' in request.resource.data.keys())
                      && !('foundingRank' in request.resource.data.keys())
                    );

      // Update paths:
      //   1. Admin — unrestricted.
      //   2. Owner — may edit profile fields only (no isVerified / tier /
      //      rating changes, ownerUid frozen).
      //   3. Any signed-in user — only when the diff is exactly the rating
      //      fields, AND the new average is in the valid 1..5 range, AND
      //      the count is incremented by exactly 1. Without these bounds
      //      anyone could pin a competitor at 0.0 / 0 reviews. The proper
      //      long-term fix is to move rating aggregation to a Cloud Function
      //      so clients don't touch these fields at all.
      allow update: if isAdmin()
                    || (
                      isSignedIn()
                      && resource.data.ownerUid == request.auth.uid
                      && request.resource.data.ownerUid == resource.data.ownerUid
                      && request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasOnly(businessOwnerMutableFields())
                    );
      // ratingAvg / ratingCount / ratingSum are backend-owned: written
      // ONLY by the onReviewWritten Cloud Function via the Admin SDK.
      // No client rating-write path exists (was abused to forge/pin ratings).

      // Owner of the business may delete their own listing (drives the
      // self-delete cascade). Admins can delete any.
      allow delete: if isAdmin()
                    || (isSignedIn()
                        && resource.data.ownerUid == request.auth.uid);
    }

    // ---------- Categories ----------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Products ----------
    match /products/{productId} {
      allow read: if true;

      // Create: only the owner of the referenced business, and no seeded
      // rating (fields must be absent or zero — the model writes 0.0/0).
      allow create: if ownsBusiness(request.resource.data.businessId)
                    && request.resource.data.businessId is string
                    && (!('ratingAvg' in request.resource.data.keys())
                        || request.resource.data.ratingAvg == 0)
                    && (!('ratingCount' in request.resource.data.keys())
                        || request.resource.data.ratingCount == 0);

      // Update paths:
      //   1. Admin — unrestricted.
      //   2. Business owner — may edit any field EXCEPT the rating aggregates
      //      (ratingAvg/ratingCount/ratingSum) and businessId, which is pinned
      //      so a product can't be reassigned to another business.
      // Rating aggregates are backend-owned: written ONLY by the
      // onProductReviewWritten Cloud Function via the Admin SDK.
      allow update: if isAdmin()
                    || (
                      ownsBusiness(resource.data.businessId)
                      && request.resource.data.businessId == resource.data.businessId
                      && !request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasAny(['ratingAvg', 'ratingCount', 'ratingSum'])
                    );

      // Hard delete: admin OR the owning business (drives self-delete
      // cascade when the merchant wipes their account). The normal
      // "delete a product" flow remains soft-delete via update.
      allow delete: if isAdmin() || ownsBusiness(resource.data.businessId);
    }

    // ---------- Offers ----------
    match /offers/{offerId} {
      allow read: if true;
      allow create: if ownsBusiness(request.resource.data.businessId);
      allow update: if isAdmin()
                    || (
                      ownsBusiness(resource.data.businessId)
                      && request.resource.data.businessId == resource.data.businessId
                    );
      allow delete: if isAdmin() || ownsBusiness(resource.data.businessId);
    }

    // ---------- Reviews ----------
    match /reviews/{reviewId} {
      allow read: if true;

      // Create: caller must stamp themselves as the reviewer AND the
      // referenced business must actually exist. Prevents impersonation,
      // userId spoofing, and spam reviews against random / fake business
      // IDs that would otherwise pollute the collection. Comment is also
      // length-capped so a single doc can't blow up storage cost.
      // One review per (user, business): the doc id is pinned to
      // `${uid}_${businessId}`, so a second submission overwrites the first
      // instead of stacking duplicates (spam / vote-stuffing prevention).
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && reviewId == request.auth.uid + '_' + request.resource.data.businessId
                    && request.resource.data.businessId is string
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && (
                      !('comment' in request.resource.data.keys())
                      || (request.resource.data.comment is string
                          && request.resource.data.comment.size() <= 2000)
                    )
                    && exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId));

      // Author may revise their own review (rating/comment only; userId +
      // businessId frozen). Admin may moderate. The onReviewWritten trigger
      // re-aggregates on any change.
      allow update: if isAdmin()
                    || (
                      isSignedIn()
                      && resource.data.userId == request.auth.uid
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.businessId == resource.data.businessId
                      && request.resource.data.rating is number
                      && request.resource.data.rating >= 1
                      && request.resource.data.rating <= 5
                      && (
                        !('comment' in request.resource.data.keys())
                        || (request.resource.data.comment is string
                            && request.resource.data.comment.size() <= 2000)
                      )
                    );
      // Delete: admin OR the review's author only. The business-owner delete
      // path was removed — it let merchants scrub their own bad reviews.
      // Merchant account/business deletion now cascades server-side
      // (onBusinessDeleted Cloud Function).
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---------- Product Reviews ----------
    // Per-product reviews. Sibling collection to /reviews (business
    // reviews). Same shape minus the businessId existence check — here
    // the existence check pins to the parent product instead.
    match /productReviews/{reviewId} {
      allow read: if true;

      // One review per (user, product): doc id pinned to `${uid}_${productId}`
      // so a re-submit overwrites rather than stacking duplicates.
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && reviewId == request.auth.uid + '_' + request.resource.data.productId
                    && request.resource.data.productId is string
                    && request.resource.data.businessId is string
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && (
                      !('comment' in request.resource.data.keys())
                      || (request.resource.data.comment is string
                          && request.resource.data.comment.size() <= 2000)
                    )
                    && exists(/databases/$(database)/documents/products/$(request.resource.data.productId));

      // Author may revise their own review (rating/comment only; identity
      // fields frozen). Admin may moderate. onProductReviewWritten re-aggregates.
      allow update: if isAdmin()
                    || (
                      isSignedIn()
                      && resource.data.userId == request.auth.uid
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.productId == resource.data.productId
                      && request.resource.data.businessId == resource.data.businessId
                      && request.resource.data.rating is number
                      && request.resource.data.rating >= 1
                      && request.resource.data.rating <= 5
                      && (
                        !('comment' in request.resource.data.keys())
                        || (request.resource.data.comment is string
                            && request.resource.data.comment.size() <= 2000)
                      )
                    );
      // Delete: admin OR the review's author only. Business-owner delete
      // removed (review-scrubbing); merchant/business deletion cascades
      // server-side via onBusinessDeleted.
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---------- Favorites ----------
    match /favorites/{favoriteId} {
      // Reads restricted to the favorite's owner. The `resource == null`
      // short-circuit is required because the toggle's pre-write `get`
      // hits a non-existent doc on the very first favorite tap, and
      // Firestore evaluates this rule even for missing docs — without it,
      // first-time favorite silently fails with permission-denied. For
      // existing docs the standard `userId == auth.uid` check applies, so
      // list queries (`where('userId', isEqualTo: uid)`) work normally.
      allow read: if isSignedIn()
                  && (
                    resource == null
                    || resource.data.userId == request.auth.uid
                  );

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;

      allow update: if false;
    }

    // ---------- Reports ----------
    match /reports/{reportId} {
      // Reports are for moderation — only the submitter and admins read.
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.userId == request.auth.uid);

      // `details` is user-supplied free text — cap to keep a single report
      // from blowing up storage / read cost.
      //
      // NOTE: each optional-field clause must also allow `== null`.
      // The client writes `details: null` (and `reason: null`) when the
      // user submits a report without a note. In Firestore rules a null
      // field still counts as present (`'details' in keys()` is true),
      // but `null is string` is false — so without the explicit null
      // allowance the rule rejected every no-note report with
      // "caller does not have permission." Reports with a note passed
      // because the value was a string. Adding `== null` fixes the
      // no-note path.
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && (
                      !('details' in request.resource.data.keys())
                      || request.resource.data.details == null
                      || (request.resource.data.details is string
                          && request.resource.data.details.size() <= 2000)
                    )
                    && (
                      !('reason' in request.resource.data.keys())
                      || request.resource.data.reason == null
                      || (request.resource.data.reason is string
                          && request.resource.data.reason.size() <= 200)
                    );

      allow update: if isAdmin();
      // Reporter may delete their own report (drives self-delete cascade).
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---------- Business engagement stats (analytics) ----------
    match /business_stats/{businessId} {
      // Only the owning business (or an admin) may read its numbers.
      allow read: if isAdmin() || ownsBusiness(businessId);

      // Counters are backend-only: written exclusively by the
      // recordEngagement callable (Admin SDK bypasses rules). Direct client
      // writes are denied so a competitor's numbers can't be forged/zeroed.
      allow create, update: if false;

      allow delete: if isAdmin();
    }

    // ---------- Per-product engagement stats (analytics) ----------
    match /product_stats/{productId} {
      // The owning business (derived from the doc's businessId) or an admin
      // may read. ownsBusiness does a get() on the business doc — fine for
      // a seller listing their own handful of products.
      allow read: if isAdmin() || ownsBusiness(resource.data.businessId);

      // Backend-only, same as business_stats: written exclusively by the
      // recordEngagement callable via the Admin SDK.
      allow create, update: if false;

      allow delete: if isAdmin();
    }

    // ---------- Conversations (in-app chat) ----------
    match /conversations/{conversationId} {
      // Only the customer or the seller listed on the doc can read/update.
      // The `resource == null` short-circuit is required because
      // `openConversation`'s pre-write `get` hits a non-existent doc on
      // the very first "Chat Seller" tap, and Firestore evaluates this
      // rule even for missing docs — without it, the customer's first
      // tap silently fails with permission-denied. For existing docs the
      // standard participantIds check applies, so both the customer's
      // list query (`where('customerId', isEqualTo: uid)`) and the
      // seller's (`where('sellerId', isEqualTo: uid)`) work normally
      // because every returned doc has the requester in participantIds.
      allow read: if isSignedIn()
                  && (
                    resource == null
                    || request.auth.uid in resource.data.participantIds
                  );

      // Customer side creates the doc. Caller must stamp themselves as
      // customerId and be a member of participantIds. participantIds must
      // contain both the customer and the seller, no one else.
      allow create: if isSignedIn()
                    && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.participantIds is list
                    && request.resource.data.participantIds.size() == 2
                    && request.auth.uid in request.resource.data.participantIds
                    && request.resource.data.sellerId in request.resource.data.participantIds
                    && request.resource.data.sellerId != request.auth.uid
                    && request.resource.data.productId is string
                    && request.resource.data.businessId is string;

      // Either party may update the conversation. Frozen identity fields
      // (sellerId, customerId, productId, businessId) prevent a participant
      // from reassigning the thread. The list-equality check on
      // participantIds was dropped — those four scalar identity fields
      // already pin the thread, and list equality in rules can falsely
      // reject when the SDK normalizes array ordering during partial
      // updates.
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participantIds
                    && request.resource.data.sellerId == resource.data.sellerId
                    && request.resource.data.customerId == resource.data.customerId
                    && request.resource.data.productId == resource.data.productId
                    && request.resource.data.businessId == resource.data.businessId;

      // Deletes: admin OR any participant (drives self-delete cascade
      // — when one side of a conversation wipes their account, the
      // whole thread goes with them so no orphaned context lingers).
      allow delete: if isAdmin()
                    || (isSignedIn()
                        && request.auth.uid in resource.data.participantIds);

      match /messages/{messageId} {
        function parentParticipants() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        }

        allow read: if isSignedIn() && request.auth.uid in parentParticipants();

        allow create: if isSignedIn()
                      && request.auth.uid in parentParticipants()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000;

        // Messages are immutable from the client.
        allow update: if false;
        // Delete: admin OR any participant of the parent conversation
        // (self-delete cascade wipes the messages subcollection before
        // removing the conversation doc).
        allow delete: if isAdmin()
                      || (isSignedIn()
                          && request.auth.uid in parentParticipants());
      }
    }

    // ---------- Blocks (App Store Guideline 1.2 user safety) ----------
    // One doc per (blocker, blocked) pair, id = "${blockerUid}_${blockedUid}".
    // A user may only create, read, and delete their OWN block records
    // (where they are the blocker). This powers the blockedUidsProvider
    // stream that filters a blocked user's content out of the blocker's
    // feed instantly.
    match /blocks/{blockId} {
      // Read is used by the query where('blockerUid', '==', auth.uid),
      // so each returned doc must belong to the caller.
      allow read: if isSignedIn()
                  && resource.data.blockerUid == request.auth.uid;

      // Create your own block. Caller must stamp themselves as the
      // blocker and cannot block themselves.
      allow create: if isSignedIn()
                    && request.resource.data.blockerUid == request.auth.uid
                    && request.resource.data.blockedUid is string
                    && request.resource.data.blockedUid != request.auth.uid;

      // No edits — a block is created or deleted, never mutated.
      allow update: if false;

      // Unblock — only the blocker may remove their own block.
      allow delete: if isSignedIn()
                    && resource.data.blockerUid == request.auth.uid;
    }

    // ---------- Notifications ----------
    match /notifications/{notificationId} {
      // Users can only read their own notifications.
      allow read: if isSignedIn()
                  && resource.data.userId == request.auth.uid;

      // Clients may stage notifications addressed to themselves (e.g. the
      // welcome message at sign-up). Cross-user notifications still require
      // a trusted backend (Cloud Functions / Admin SDK). Title + body are
      // length-capped so a self-mint can't be used to bloat the collection.
      allow create: if isAdmin()
                    || (
                      isSignedIn()
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 200
                      && request.resource.data.body is string
                      && request.resource.data.body.size() <= 1000
                    );

      // Users can mark their own notifications read, but not change userId
      // or the notification content.
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['read', 'readAt']);

      // Recipient may delete their own notifications (drives self-delete
      // cascade). Admin can delete any.
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---------- Payments (portal) ----------
    // The payment lifecycle is 100% backend-owned: docs are created by the
    // submitPayment callable and transitioned by reviewPayment (Admin SDK,
    // bypasses rules). Clients can only READ — the owning business sees its
    // own history, admins see the queue. No client write path exists, so
    // amounts, statuses and duplicate locks cannot be forged.
    match /payments/{paymentId} {
      allow read: if isAdmin()
                  || (isSignedIn() && ownsBusiness(resource.data.businessId));
      allow create, update, delete: if false;
    }

    // Duplicate-submission locks (see paymentDupeKey in functions/index.js).
    // Purely internal bookkeeping — no client access at all.
    match /payment_dupes/{dupeKey} {
      allow read, write: if false;
    }

    // ---------- Invoices (portal) ----------
    // Issued ONLY by reviewPayment inside the approval transaction, with a
    // sequential number from /counters. Lifecycle changes (void/restore/
    // re-email) go through the manageInvoice callable. Clients read-only:
    // the owning business sees its own invoices, admins see all.
    match /invoices/{invoiceId} {
      allow read: if isAdmin()
                  || (isSignedIn() && ownsBusiness(resource.data.businessId));
      allow create, update, delete: if false;
    }

    // Sequence counters (invoice numbering) — backend-only bookkeeping.
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // Monthly-report snapshots (delta baselines) — backend-only.
    match /reportSnapshots/{businessId} {
      allow read, write: if false;
    }

    // Executive-report send markers (weekly/quarterly/yearly) — backend-only.
    match /execReports/{businessId} {
      allow read, write: if false;
    }

    // ---------- Analytics daily buckets (portal BI) ----------
    // Written ONLY by recordEngagement / recordSearchEvent via the Admin
    // SDK. Each business reads its own buckets (docs carry businessId);
    // admins read all. Same confidentiality bar as the lifetime stats:
    // no merchant can ever read another merchant's numbers.
    match /stats_daily/{bucketId} {
      allow read: if isAdmin()
                  || (isSignedIn() && ownsBusiness(resource.data.businessId));
      allow write: if false;
    }
    match /product_stats_daily/{bucketId} {
      allow read: if isAdmin()
                  || (isSignedIn() && ownsBusiness(resource.data.businessId));
      allow write: if false;
    }
    match /search_daily/{bucketId} {
      allow read: if isAdmin()
                  || (isSignedIn() && ownsBusiness(resource.data.businessId));
      allow write: if false;
    }
    match /product_search_daily/{bucketId} {
      allow read: if isAdmin()
                  || (isSignedIn() && ownsBusiness(resource.data.businessId));
      allow write: if false;
    }

    // Market-wide search-term demand. Raw terms are NOT client-readable
    // (they could contain user-typed text and are market intelligence);
    // the Vibranium surfaces consume the anonymized aggregates produced
    // by the nightly job instead. Admin read for operations only.
    match /search_terms_daily/{bucketId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Nightly per-business insights (positions, percentiles, benchmarks).
    // Doc id == businessId; strictly owner + admin. Written only by the
    // nightlyMarketAggregation job.
    match /bizInsights/{businessId} {
      allow read: if isAdmin()
                  || (isSignedIn() && ownsBusiness(businessId));
      allow write: if false;
    }

    // Anonymous marketplace aggregates (category demand, tier averages,
    // top/trending terms). Contains NO business or product identities, so
    // any signed-in user may read; tier gating of the fancy surfaces is a
    // portal-UI concern. Written only by the nightly job.
    match /marketAggregates/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---------- Upgrade requests (portal) ----------
    // One open request per business, doc id == businessId, created and
    // transitioned ONLY by the requestUpgrade/decideUpgrade callables.
    // The owning business and admins may read; nobody writes client-side.
    match /upgradeRequests/{businessId} {
      allow read: if isAdmin()
                  || (isSignedIn() && ownsBusiness(businessId));
      allow create, update, delete: if false;
    }

    // Rate-limiter state — backend-only. Exposing reads would leak other
    // users' activity patterns; writes would let attackers reset limits.
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // ---------- Portal configuration ----------
    // Admin-editable settings the portal renders (bank account details for
    // transfers, tier price overrides). Readable by any signed-in user;
    // only admins may change it.
    match /portalConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- Audit logs (portal) ----------
    // Tamper-proof operational trail. Entries are written EXCLUSIVELY by
    // Cloud Functions via the Admin SDK (writeAudit in functions/index.js),
    // which bypasses these rules. No client — not even an admin session —
    // can create, alter, or purge audit history.
    match /auditLogs/{entryId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
