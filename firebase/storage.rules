rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    // Two valid admin signals, mirroring firestore.rules isAdmin():
    //   1) custom claim admin == true (preferred, no Firestore read), OR
    //   2) /users/{uid}.role == 'admin' (console-promoted admins who don't
    //      have the claim yet). Costs one Firestore get() per admin write.
    function isAdmin() {
      // `'admin' in token` guard: reading a missing claim raises an
      // evaluation error in the Storage rules engine, and that error is
      // NOT recovered by `||` — an unguarded read here denies writes for
      // every non-admin (i.e. all merchant uploads). Caught by
      // storage.rules.test.js; keep the guard.
      return isSignedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true)
        || (
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // Owns the referenced business doc (Firestore lookup).
    function ownsBusiness(businessId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/businesses/$(businessId))
        && firestore.get(/databases/(default)/documents/businesses/$(businessId))
             .data.ownerUid == request.auth.uid;
    }

    // Standard image constraints: ≤ 5 MB, image/* only. The picker
    // downscales to maxWidth 1600 + quality 80 which keeps real uploads
    // well under ~600 KB; the client compresses anything over the cap
    // before sending so legit users don't get blocked on raw camera
    // shots. (contentType is client-supplied and spoofable — defense in
    // depth would be a Cloud Function that re-reads magic bytes.)
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ---------- User photos ----------
    match /users/{uid}/{allPaths=**} {
      allow read: if true; // profile photos are public
      allow write: if isSignedIn()
                   && request.auth.uid == uid
                   && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ---------- Business assets (logo, banner) ----------
    match /businesses/{businessId}/{allPaths=**} {
      allow read: if true;
      allow write: if (ownsBusiness(businessId) || isAdmin())
                   && isValidImage();
      allow delete: if ownsBusiness(businessId) || isAdmin();
    }

    // ---------- Product images ----------
    // Product paths are scoped to the business that owns them so the rule
    // can authorize by business ownership. The app currently uploads to
    //   /products/{businessId}/{timestamp}_{index}.{ext}
    // (productId isn't allocated until after upload). The {allPaths=**}
    // wildcard accepts that layout; if you tighten the path here, update
    // add_edit_product_screen.dart::_uploadNewImages in lockstep.
    match /products/{businessId}/{allPaths=**} {
      allow read: if true;
      allow write: if (ownsBusiness(businessId) || isAdmin())
                   && isValidImage();
      allow delete: if ownsBusiness(businessId) || isAdmin();
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
